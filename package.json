{
  "name": "myschool",
  "version": "1.0.0",
  "private": true,
  "description": "A shared school platform with student web and teacher/admin desktop apps",
  "scripts": {
    "dev:api": "node --watch server/index.js",
    "dev:student": "vite --config apps/student/vite.config.js",
    "dev:teacher": "vite --config apps/teacher/vite.config.js",
    "dev:admin": "vite --config apps/admin/vite.config.js",
    "dev": "concurrently -k -n api,student,teacher,admin -c blue,green,magenta,yellow \"npm:dev:api\" \"npm:dev:student\" \"npm:dev:teacher\" \"npm:dev:admin\"",
    "build": "vite build --config apps/student/vite.config.js && vite build --config apps/teacher/vite.config.js && vite build --config apps/admin/vite.config.js",
    "start:api": "node server/index.js",
    "student": "vite --config apps/student/vite.config.js",
    "teacher": "vite --config apps/teacher/vite.config.js",
    "admin": "vite --config apps/admin/vite.config.js",
    "electron:teacher": "electron apps/teacher/electron/main.cjs",
    "electron:admin": "electron apps/admin/electron/main.cjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "styled-components": "^6.5.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "electron": "^44.4.5",
    "vite": "^6.3.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron@44.4.5": true
  }
}
